# Etapa 1: Compilación
FROM rust:1.75-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

# Etapa 2: Imagen final ligera para ejecución
FROM debian:bookworm-slim
WORKDIR /app

# Instalar dependencias necesarias para SSL/TLS (requisito para conectar con Supabase)
RUN apt-get update && apt-get install -y libssl-dev ca-certificates && rm -rf /var/lib/apt/lists/*

# Copiar el binario compilado desde la etapa anterior
COPY --from=builder /app/target/release/citas-backend /app/citas-backend

EXPOSE 4000
CMD ["./citas-backend"]